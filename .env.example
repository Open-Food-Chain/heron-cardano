# Copy to a file OUTSIDE the repo on the host and point HERON_ENV_FILE at it.
# Fill in values there; never commit real values.
POSTGRES_USER=
POSTGRES_PASSWORD=
# Database location. Host and port are for an external database; the bundled
# db service always listens on db:5432. Empty means the default shown.
# Default: db
POSTGRES_HOST=db
# Default: 5432
POSTGRES_PORT=5432
# Database name; the bundled db service creates it. Default: heron_db
POSTGRES_DB=heron_db
# Schema for the tables and alembic_version (letters, digits, underscore; not
# starting with a digit). Created by the migrations. Default: public.
# Changing it on a database that already has data does not move that data.
POSTGRES_SCHEMA=public
BLOCKFROST_PROJECT_ID=
WALLET_ENCRYPTION_KEY=
# Optional: only for a custom (non-Blockfrost-default) network
CUSTOM_BLOCKFROST_API_URL=
